/* Accent: teal #0F766E. Light theme, large text and targets for everyday shop use. */
QWidget { background: #FFFFFF; color: #1F2937; font-size: 15px; }
QMainWindow, QStackedWidget { background: #FFFFFF; }

#sidebar { background: #F1F6F6; border-right: 1px solid #D5E2E1; }
#sidebarTitle { background: transparent; color: #0F766E; font-size: 20px; font-weight: 700; padding: 16px 16px 12px 16px; }
#navButton { background: transparent; border: none; border-left: 4px solid transparent; text-align: left;
             padding: 12px 14px; font-size: 15px; color: #1F2937; }
#navButton:hover { background: #E1EEED; }
#navButton:checked { background: #FFFFFF; border-left: 4px solid #0F766E; color: #0F766E; font-weight: 700; }

#topbar { background: #FFFFFF; border-bottom: 1px solid #D5E2E1; }
#topbar QLabel { background: transparent; }
#shopName { font-size: 18px; font-weight: 700; color: #0F766E; }
#dateLabel { color: #4B5563; }

#pageTitle { font-size: 24px; font-weight: 700; padding-bottom: 8px; }
#hint { color: #6B7280; }
#status { color: #0F766E; font-weight: 600; }
#statusError { color: #B91C1C; font-weight: 600; }

QLineEdit, QPlainTextEdit, QComboBox { border: 1px solid #B8C7C6; border-radius: 6px; padding: 5px 8px; background: #FFFFFF; min-height: 22px; }
QLineEdit:focus, QPlainTextEdit:focus, QComboBox:focus { border: 2px solid #0F766E; }

QPushButton { background: #0F766E; color: #FFFFFF; border: none; border-radius: 6px; padding: 8px 18px; font-weight: 600; }
QPushButton:hover { background: #0B5F58; }
QPushButton:disabled { background: #9CB8B5; }

QTabWidget::pane { border: 1px solid #D5E2E1; }
QTabBar::tab { padding: 8px 18px; background: #F1F6F6; border: 1px solid #D5E2E1; border-bottom: none; }
QTabBar::tab:selected { background: #FFFFFF; color: #0F766E; font-weight: 700; }
QScrollArea { background: transparent; }
QTableView { selection-background-color: #CDE8E5; selection-color: #0F766E; gridline-color: #E5EDEC; }
QHeaderView::section { background: #F1F6F6; border: none; border-bottom: 1px solid #D5E2E1; padding: 6px; font-weight: 600; }
